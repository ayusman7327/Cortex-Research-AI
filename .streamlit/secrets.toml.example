# Copy this example to secrets.toml for local use, or paste private values
# into Streamlit Cloud > App settings > Secrets. Never commit real secrets.
GEMINI_API_KEY = "your_api_key_here"
GEMINI_MODEL = "gemini-3.6-flash"
GEMINI_EMBEDDING_MODEL = "gemini-embedding-001"

# Recommended for Streamlit Cloud: native provider authentication.
CORTEX_AUTH_MODE = "oidc"
# Optional access restriction; remove to allow any authenticated provider user.
# CORTEX_ALLOWED_EMAILS = "person@example.com"

[auth]
redirect_uri = "https://your-app.streamlit.app/oauth2callback"
cookie_secret = "replace_with_a_long_random_secret"
client_id = "your_oauth_client_id"
client_secret = "your_oauth_client_secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
