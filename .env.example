GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TIMEOUT_SECONDS=60

# local works without an external identity provider.
# Use oidc for hosted sign-in and configure .streamlit/secrets.toml.
CORTEX_AUTH_MODE=local
CORTEX_ALLOW_REGISTRATION=true
# Optional persistent database path for local mode:
# CORTEX_AUTH_DB=data/auth.sqlite3
# Optional verified-email allowlist in oidc mode:
# CORTEX_ALLOWED_EMAILS=person@example.com
